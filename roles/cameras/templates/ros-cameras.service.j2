[Unit]
# Managed by Ansible on {{ inventory_hostname }} — do not edit by hand.
Description=ROS {{ ros_version }} cameras (camera_ros / libcamera)
# Order after the network at BOOT, but deliberately do NOT Want/Require
# network-online.target: these hosts are dual-homed (WiFi + Ethernet), and
# unplugging the Ethernet cable takes network-online.target down with it, which
# would stop the cameras even though WiFi is still up. The camera hardware is
# local — it does not need the network at all — so the service must outlive any
# interface change.
After=network.target

[Service]
Type=simple
User={{ cameras_user }}
# systemd does not read /etc/profile.d, so set the ROS env explicitly
# (mirrors /etc/profile.d/ros_env.sh) and source the ROS 2 setup in ExecStart.
Environment=ROS_DOMAIN_ID={{ ros_domain_id }}
Environment=ROS_LOCALHOST_ONLY=0
{% if cameras_build_rpi_libcamera | default(false) %}
# Prepend the Raspberry Pi libcamera build AFTER sourcing ROS so it takes
# precedence over the upstream libcamera bundled with camera_ros.
ExecStart=/bin/bash -c 'source /opt/ros/{{ ros_version }}/setup.bash && export LD_LIBRARY_PATH={{ rpi_libcamera_prefix }}/lib:$LD_LIBRARY_PATH && exec ros2 launch {{ cameras_config_dir }}/cameras.launch.py'
{% else %}
ExecStart=/bin/bash -c 'source /opt/ros/{{ ros_version }}/setup.bash && exec ros2 launch {{ cameras_config_dir }}/cameras.launch.py'
{% endif %}
# camera_ros does not always exit on SIGTERM -- it can sit in 'deactivating'
# until systemd's default 90s stop timeout expires, and a restart issued during
# that window silently does nothing. Kill quickly and escalate to SIGKILL.
TimeoutStopSec=8
KillMode=mixed
SendSIGKILL=yes
# Restart=always, NOT on-failure: camera_ros can exit with status 0 when its
# network or DDS environment changes underneath it (observed after unplugging
# Ethernet on a dual-homed host), and on-failure treats a clean exit as
# "job done" -- leaving the cameras dead until someone restarts them by hand.
Restart=always
RestartSec=5
# Do not let repeated quick restarts trip systemd's rate limiter into giving up
# permanently; keep retrying instead.
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
