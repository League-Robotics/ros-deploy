# {{ cameras_config_dir }}/cameras.launch.py
# Managed by Ansible on {{ inventory_hostname }} — do not edit by hand.
# Starts one camera_ros camera_node per camera in `cameras_list`.
# Each node publishes within its namespace:
#   /<namespace>/image_raw            (sensor_msgs/Image)
#   /<namespace>/image_raw/compressed (sensor_msgs/CompressedImage — for LAN viewing)
#   /<namespace>/camera_info          (sensor_msgs/CameraInfo)
from launch import LaunchDescription
from launch_ros.actions import Node


def generate_launch_description():
    return LaunchDescription([
{% for cam in cameras_list %}
        Node(
            package="camera_ros",
            executable="camera_node",
            # Namespace with the HOSTNAME, not just cameraN. Every fleet host
            # used to publish to /camera0/camera/image_raw on the same DDS
            # domain (42), so five machines collided on one topic and one node
            # name: `ros2 node list` showed /camera0/camera four times with
            # "nodes in the graph that share an exact name", publishers
            # appeared and vanished, web_video_server subscribed to whichever
            # host won the race, and every host advertised its peers' cameras
            # as if they were local. Prefixing the host makes each camera
            # globally unique: /skadi/camera0/camera/image_raw.
            namespace="{{ inventory_hostname }}/{{ cam.namespace }}",
            name="camera",
            parameters=[{
                "camera": {{ cam.camera }},
                "width": {{ cam.width | default(1280) }},
                "height": {{ cam.height | default(720) }},
                "frame_id": "{{ cam.frame_id | default(cam.namespace ~ '_optical_frame') }}",
{% if cam.format is defined %}
                # Pixel format. XRGB8888 (the auto-pick) comes out as bgra8 with
                # R/B swapped through web_video_server; RGB888 gives correct colour.
                "format": "{{ cam.format }}",
{% endif %}
{% if cam.fps is defined %}
                # Cap the frame rate via libcamera's FrameDurationLimits (min/max
                # frame duration in MICROseconds — inverse of FPS).
                #
                # This is a correctness fix, not a tuning knob. camera_ros
                # publishes RELIABLE with KEEP_LAST(1); left uncapped this sensor
                # free-runs at ~30 Hz, which is faster than a Pi 4 can serve, and
                # subscribers start losing messages ("A message was lost!!!" from
                # `ros2 topic echo`). web_video_server's per-request streamer then
                # never receives a frame, so it hangs forever and every later HTTP
                # request hangs behind it — the camera looks dead while the topic
                # still reports a healthy rate.
                "FrameDurationLimits": [{{ (1000000 // cam.fps) | int }}, {{ (1000000 // cam.fps) | int }}],
{% endif %}
            }],
            output="screen",
        ),
{% endfor %}
    ])
