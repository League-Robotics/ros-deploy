[Unit]
# Managed by Ansible on {{ inventory_hostname }} — do not edit by hand.
Description=ROS {{ ros_version }} camera colour relay (camera_ros R/B swap fix)
After=network-online.target {{ cameras_service_name }}.service
Wants=network-online.target
PartOf={{ cameras_service_name }}.service
BindsTo={{ cameras_service_name }}.service

[Service]
Type=simple
User={{ cameras_user }}
Environment=ROS_DOMAIN_ID={{ ros_domain_id }}
Environment=ROS_LOCALHOST_ONLY=0
ExecStart=/bin/bash -c 'source /opt/ros/{{ ros_version }}/setup.bash && exec python3 {{ cameras_config_dir }}/camera_color_relay.py {% for cam in cameras_list %}/{{ cam.namespace }}/camera/image_raw {% endfor %}'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
