#!/usr/bin/env bash
# /etc/profile.d/ros_env.sh
# Automatically sourced for every login shell on {{ inventory_hostname }}.
# Managed by Ansible — do not edit by hand.

# ── Source the ROS 2 setup script ────────────────────────
ROS_SETUP="/opt/ros/{{ ros_version }}/setup.bash"
if [ -f "${ROS_SETUP}" ]; then
  # shellcheck source=/dev/null
  source "${ROS_SETUP}"
fi

# ── ROS 2 network configuration ──────────────────────────
# All nodes sharing the same domain ID discover each other
# automatically via DDS multicast / unicast peers.
export ROS_DOMAIN_ID="{{ ros_domain_id }}"

# Use localhost-only mode only if explicitly requested.
export ROS_LOCALHOST_ONLY="${ROS_LOCALHOST_ONLY:-0}"
