# ROS environment variables for the Docker container.
# Managed by Ansible on {{ inventory_hostname }} — do not edit by hand.

{% if ros_version == 'noetic' %}
# ── ROS 1 networking ─────────────────────────────────────
# Point every node at the same roscore master.
ROS_MASTER_URI={{ ros_master_uri }}

# Advertise the *host* machine's IP (not the container's virtual IP)
# so that other nodes on the network can reach this container.
# Because we use network_mode: host the container IS the host.
ROS_IP={{ ros_node_ip }}
{% else %}
# ── ROS 2 networking ─────────────────────────────────────
# All nodes sharing the same domain ID discover each other via DDS.
ROS_DOMAIN_ID={{ ros_domain_id }}
ROS_LOCALHOST_ONLY=0
{% endif %}
