[Unit]
# Managed by Ansible on {{ inventory_hostname }} — do not edit by hand.
Description=X-drive REV Hub driver (cmd_vel -> motors)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ xdrive_user }}
# systemd does not read /etc/profile.d, so set the ROS env explicitly and source
# BOTH the base ROS install and the colcon overlay (xdrive lives in the overlay).
Environment=ROS_DOMAIN_ID={{ ros_domain_id }}
Environment=ROS_LOCALHOST_ONLY=0
ExecStart=/bin/bash -c 'source /opt/ros/{{ ros_version }}/setup.bash && source {{ xdrive_workspace_dir }}/install/setup.bash && exec ros2 run xdrive xdrive_driver --ros-args -p serial_port:={{ xdrive_serial_port }} -p cmd_vel_topic:={{ xdrive_cmd_vel_topic }} -p joint_state_topic:={{ xdrive_joint_state_topic }} -p max_power:={{ xdrive_max_power }} -p cmd_timeout_ms:={{ xdrive_cmd_timeout_ms }} -p feedback_rate_hz:={{ xdrive_feedback_rate_hz }} -p wheel_signs:="{{ xdrive_wheel_signs }}" -p motor_ports:="{{ xdrive_motor_ports }}" -p forward_scale:={{ xdrive_forward_scale }} -p strafe_scale:={{ xdrive_strafe_scale }} -p yaw_scale:={{ xdrive_yaw_scale }}'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
