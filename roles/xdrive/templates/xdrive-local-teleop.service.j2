[Unit]
# Managed by Ansible on {{ inventory_hostname }} — do not edit by hand.
#
# Local teleop: the joystick plugged into THIS host drives the REV hub
# directly — no ROS (and no WiFi) in the control path, so mesh latency spikes
# cannot reach the driving feel. ROS is only used to publish wheel encoders.
Description=X-drive local teleop (joystick -> REV Hub, ROS for encoder feedback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ xdrive_user }}
Environment=ROS_DOMAIN_ID={{ ros_domain_id }}
Environment=ROS_LOCALHOST_ONLY=0
Environment=FASTDDS_BUILTIN_TRANSPORTS=UDPv4
{% if ros_static_peers is defined %}
Environment=ROS_STATIC_PEERS={{ ros_static_peers | join(';') }}
{% endif %}
ExecStart=/bin/bash -c 'source /opt/ros/{{ ros_version }}/setup.bash && source {{ xdrive_workspace_dir }}/install/setup.bash && exec ros2 run xdrive xdrive_local_teleop --device "{{ xdrive_joy_device }}" --axis-forward {{ xdrive_joy_axis_forward }} --axis-strafe {{ xdrive_joy_axis_strafe }} --axis-yaw {{ xdrive_joy_axis_yaw }} --invert-forward {{ xdrive_joy_invert_forward | string | lower }} --invert-strafe {{ xdrive_joy_invert_strafe | string | lower }} --invert-yaw {{ xdrive_joy_invert_yaw | string | lower }} --deadzone {{ xdrive_joy_deadzone }} --control-mode {{ xdrive_control_mode }} --max-velocity {{ xdrive_max_velocity }} --max-power {{ xdrive_max_power }} --motor-ports "{{ xdrive_motor_ports | replace("[", "") | replace("]", "") | replace(" ", "") }}" --wheel-signs="{{ xdrive_wheel_signs | replace("[", "") | replace("]", "") | replace(" ", "") }}" --wheel-scales="{{ xdrive_wheel_scales | default("1,1,1,1") }}" --forward-scale {{ xdrive_forward_scale }} --strafe-scale {{ xdrive_strafe_scale }} --yaw-scale {{ xdrive_yaw_scale }} --serial-port "{{ xdrive_serial_port }}" --apply-hz {{ xdrive_local_apply_hz }} --slew {{ xdrive_local_slew }} --quantum {{ xdrive_local_quantum }} --feedback-hz {{ xdrive_feedback_rate_hz }} --joint-topic {{ xdrive_joint_state_topic }} --cal-buttons "{{ xdrive_cal_buttons }}" --cal-velocity {{ xdrive_cal_velocity }}'
# Restart=always: the program exits(1) when it cannot establish a healthy hub
# session (e.g. cold-boot serial garbage) — restarting IS the retry loop.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
