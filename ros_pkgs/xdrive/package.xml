<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xdrive</name>
  <version>0.1.0</version>
  <description>
    X-drive teleop for a 4-motor holonomic robot driven by a REV Robotics Hub.
    joy_to_twist maps a gamepad (Joy) to a Twist on cmd_vel; xdrive_driver applies
    X-drive inverse kinematics and drives the hub over serial via the rhsp library,
    publishing wheel encoder feedback as JointState.
  </description>
  <maintainer email="eric.busboom@jointheleague.org">Eric Busboom</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- NOTE: rhsp (REV Hub serial library) is NOT a rosdep key; it is installed
       on the host by roles/revhub. Intentionally not declared here so that
       `rosdep install` does not fail trying to resolve it. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
